# API Keys (leave empty or unset to run Ollama offline)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Provider: groq, gemini, openai, or ollama (for offline execution)
DEFAULT_PROVIDER=ollama

# Model Configurations
GROQ_MODEL=groq/compound-mini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

DEFAULT_SYSTEM_PROMPT="You are a helpful, concise, and smart AI Assistant running inside a terminal CLI environment."

